IMPLEMENTATION block_i
REFINES block

IMPORTS
    acquisition_bs
    
VALUES
    BLOCKS = 0..3;
    SIGNALS = 0..3;
    NEXT = {0 |-> 1, 1 |-> 2, 2 |-> 3, 3 |-> 0}
    
CONCRETE_VARIABLES
    phase_i,
    occupied_i,
    signals_red_i
    
INVARIANT
    phase_i : PHASE &
    phase = phase_i &
    occupied_i  : BLOCKS --> BOOL &
    signals_red_i  : BLOCKS --> BOOL  &
    occupied = occupied_i~[{TRUE}] &
    signals_red = signals_red_i~[{TRUE}]
    
INITIALISATION
    phase_i := ACQUISITION;
    occupied_i := BLOCKS * {TRUE};
    signals_red_i := BLOCKS * {TRUE}
    
OPERATIONS
    
    actualise_occupation =
        BEGIN
           VAR bb0,bb1,bb2,bb3 IN
                bb0 <-- capteur0;
                occupied_i(0) := bb0;
                bb1 <-- capteur1;
                occupied_i(1) := bb1;
                bb2 <-- capteur2;
                occupied_i(2) := bb2;
                bb3 <-- capteur3;
                occupied_i(3) := bb3
            END;
        phase_i := CONTROLE
        END;
    
    controle_light =
        BEGIN
            signals_red_i(0) := occupied_i(0);
            signals_red_i(1) := occupied_i(1);
            signals_red_i(2) := occupied_i(2);
            signals_red_i(3) := occupied_i(3);
            phase_i := ACQUISITION
        END;

    bb <-- is_occupied(xx) =
        BEGIN
            bb := occupied_i(xx)
        END;

    bb <-- is_red(xx) =
        BEGIN
            bb := signals_red_i(xx)
        END

END